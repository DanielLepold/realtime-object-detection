# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Model weights (large binary files)
*.pt
*.pth
*.onnx
*.engine
weights/

# Video files (may contain personal data – see GDPR notice in README)
assets/videos/*.mp4
assets/videos/*.avi
assets/videos/*.mov
assets/videos/*.mkv
!assets/videos/.gitkeep

# Output videos
output/

# Jupyter
.ipynb_checkpoints/
*.ipynb
!notebooks/*.ipynb

# Logs
*.log
logs/

# Training runs (weights, metrics) – large binary files
runs/

# Dataset files – never commit raw footage or annotations (GDPR + size)
datasets/*/
datasets/*.zip
!datasets/.gitkeep
